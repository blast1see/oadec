  "what_the_census_costs": {
   "method": "the census is taken on every `verify`, asked for or not; `python tools/bench.py --compare` between main and this branch, seven runs turn and turn about, over the two heaviest streams of each kind under 700 seconds, and `verify --json` of one whole film (2,608,566,196 bytes, 6,058,052 access units) five times with each binary",
   "streams_of_the_comparison": "ratio of the median wall times of `verify`, this branch over main: 1.000 to 1.002 on the four TrueHD streams, each within the spread of its runs; the processor time reads 1.14 on one of them, a run of about a tenth of a second measured with a clock that steps by 15.6 ms",
   "the_whole_film": {
    "main_median_seconds": 25.52,
    "this_branch_median_seconds": 25.34,
    "ratio": 0.993
   }
  },
  "old_and_new_over_the_125_streams": {
   "method": "`python tools/old_new.py --decode-all`, main against this branch before it was moved onto the extractor fix",
   "streams": 125,
